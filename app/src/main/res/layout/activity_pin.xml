<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_horizontal" android:padding="24dp"
    android:background="@color/screen_bg" android:layoutDirection="rtl">
    <TextView android:id="@+id/pinTitle" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textSize="26sp" android:textStyle="bold"
        android:textColor="@color/primary" />
    <TextView android:id="@+id/pinHint" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="10dp"
        android:gravity="center" android:textSize="15sp" android:textColor="@color/muted" />
    <EditText android:id="@+id/pin1" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="28dp"
        android:gravity="center" android:inputType="numberPassword" android:maxLength="8" android:hint="PIN" />
    <EditText android:id="@+id/pin2" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:gravity="center" android:inputType="numberPassword" android:maxLength="8" android:hint="אישור PIN" />
    <Button android:id="@+id/pinAction" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="המשך" />
</LinearLayout>
